{
  "name": "Shop",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "Basic",
        "Shopify",
        "Advanced",
        "Plus"
      ],
      "default": "Basic"
    },
    "contact_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Paused"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}